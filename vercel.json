{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "^/api/nft/([^/]+)$", "dest": "/api/nft/[tokenId]?tokenId=$1" },

    { "handle": "filesystem" },

    { "src": "^/kiosk$", "dest": "/" },
    { "src": "^/kiosk/(.*)$", "dest": "/" },

    { "src": "^/(.*)$", "dest": "/" }
  ]
}
