{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "^/@vite/(.*)$",
      "dest": "/@vite/$1"
    },
    {
      "src": "^/@react-refresh$",
      "dest": "/@react-refresh"
    },
    {
      "src": "^/src/(.*)$",
      "dest": "/src/$1"
    },
    {
      "src": "^/api/nft/([^/]+)$",
      "dest": "/api/nft/[tokenId].ts?tokenId=$1"
    },
    {
      "src": "^/verify/vote/([^/]+)/?$",
      "dest": "/api/verify/vote/[voteId].ts?voteId=$1"
    },
    {
      "src": "^/verify/nft/([^/]+)/?$",
      "dest": "/api/verify/nft/[tokenId].ts?tokenId=$1"
    },
    {
      "src": "^/api/verify/vote/([^/]+)/?$",
      "dest": "/api/verify/vote/[voteId].ts?voteId=$1"
    },
    {
      "src": "^/api/verify/nft/([^/]+)/?$",
      "dest": "/api/verify/nft/[tokenId].ts?tokenId=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/"
    }
  ]
}
